<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <IsAotCompatible>false</IsAotCompatible>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
    <IsPackable>true</IsPackable>

    <!--<PublishAot>true</PublishAot>
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>full</TrimMode>-->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AdHoc.Results.Abstractions" />
    <Using Include="AdHoc.Results" />
    <Using Include="AdHoc.Results.Result" Static="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AdHoc.Results/AdHoc.Results.csproj" />
  </ItemGroup>
  
  <Target Name="DefineAOTConstants" BeforeTargets="BeforeCompile">
    <PropertyGroup Condition="'$(PublishAot)' == 'true'">
      <DefineConstants>$(DefineConstants);AOT</DefineConstants>
    </PropertyGroup>
  </Target>
</Project>
